# ═══ /etc/ai-dev.env — конфиг AI dev loop. Права строго 600! ═══

# ── Аутентификация Claude: заполните ОДНО из двух ──
# Подписка Pro/Max (токен выдаёт команда: claude setup-token):
CLAUDE_CODE_OAUTH_TOKEN=
# Либо API-ключ с console.anthropic.com:
# ANTHROPIC_API_KEY=

# ── Проект ──
REPO_DIR=/home/REPLACE_ME_USER/project
BASE_BRANCH=main
# Второй репозиторий проекта, формат owner/name (межрепозиторная
# блокировка): в backend-конфиге — android-репо, в android — backend.
PARTNER_REPO=
# GitHub-логины (через пробел), чьи issues берутся в работу.
# Пусто = только владелец gh-токена (защита от prompt injection).
ALLOWED_AUTHORS=

# ── Поведение цикла ──
CLAUDE_MODEL=sonnet
MAX_ITERATIONS=3
AUTO_MERGE=false
CI_START_WAIT=30
# Лимит $ на один вызов (действует только с ANTHROPIC_API_KEY):
MAX_BUDGET_USD=5

# ── Telegram-уведомления (по желанию, см. TELEGRAM.md) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Режим разработки ──
# local      = Claude думает на этом сервере (для приватного backend)
# github-app = @claude думает на GitHub Actions (для публичного android)
DEV_MODE=local
# github-app: сколько минут ждать появления PR / фикса от @claude
APP_WAIT_MIN=45
